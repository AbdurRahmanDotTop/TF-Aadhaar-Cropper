---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contact Us">
    <div class="w-full max-w-[800px] mx-auto px-lg py-5xl">
        <h1 class="text-display-lg font-bold tracking-tight text-ink mb-md">Contact Us</h1>
        
        <p class="text-body-lg text-body mb-xl">
            Have questions, feedback, or need support? We're here to help. Reach out to us using the information below.
        </p>

        <div class="grid md:grid-cols-2 gap-lg">
            <div class="card-marketing">
                <h3 class="text-display-sm font-semibold text-ink mb-sm">Support Information</h3>
                <p class="text-body-md text-body mb-xs"><strong>Email:</strong> <a href="mailto:support@techilyfly.com" class="text-link hover:underline">support@techilyfly.com</a></p>
                <p class="text-body-md text-body mb-xs"><strong>Developer Email:</strong> <a href="mailto:abdurrahman@techilyfly.com" class="text-link hover:underline">abdurrahman@techilyfly.com</a></p>
                <p class="text-body-md text-body mb-xs"><strong>Phone:</strong> +918825164657</p>
                <p class="text-body-md text-body"><strong>Name:</strong> AbdurRahman</p>
            </div>

            <div class="card-marketing bg-canvas-soft">
                <h3 class="text-display-sm font-semibold text-ink mb-sm">Operating Hours</h3>
                <p class="text-body-md text-body">
                    We typically respond to emails within 24-48 business hours. For faster resolution, please include details about the issue you are facing.
                </p>
                <p class="text-body-sm text-mute mt-md">
                    Note: We do not store any Aadhaar data. If you are having issues processing your PDF, please ensure it is a valid e-Aadhaar file.
                </p>
            </div>
        </div>
    </div>
</Layout>
