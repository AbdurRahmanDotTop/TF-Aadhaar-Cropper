---
import '../styles/global.css';

interface Props {
	title: string;
    description?: string;
}

const { title, description = "Securely crop and process your Aadhaar Card PDFs or Images directly in your browser without any server uploads. Fast, private, and free." } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={description} />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title} | TF Aadhaar Cropper</title>
        
        <!-- Preconnect to Google Fonts -->
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <!-- Load Inter and IBM Plex Mono -->
        <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
	</head>
	<body class="min-h-screen flex flex-col">
        <!-- Navigation -->
        <header class="sticky top-0 z-50 bg-canvas/80 backdrop-blur-md border-b border-hairline w-full h-[64px]">
            <div class="max-w-[1400px] mx-auto px-lg h-full flex items-center justify-between">
                <a href="/" class="flex items-center gap-2 font-semibold text-ink focus-visible:ring-2 focus-visible:ring-primary focus-visible:outline-none rounded-xs">
                    <svg viewBox="0 0 24 24" width="24" height="24" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" class="text-primary"><path d="M3 7V5a2 2 0 0 1 2-2h2"></path><path d="M17 3h2a2 2 0 0 1 2 2v2"></path><path d="M21 17v2a2 2 0 0 1-2 2h-2"></path><path d="M7 21H5a2 2 0 0 1-2-2v-2"></path><rect width="7" height="5" x="7" y="7" rx="1"></rect><rect width="7" height="5" x="10" y="12" rx="1"></rect></svg>
                    <span>TF Aadhaar Cropper</span>
                </a>
                
                <nav class="flex items-center gap-1 md:gap-sm">
                    <a href="/" class="text-body text-xs md:text-sm font-medium hover:text-ink px-2 md:px-3 py-1.5 rounded-full hover:bg-canvas-soft-2 transition-colors focus-visible:ring-2 focus-visible:ring-primary focus-visible:outline-none">Home</a>
                    <a href="/dashboard" class="text-body text-xs md:text-sm font-medium hover:text-ink px-2 md:px-3 py-1.5 rounded-full hover:bg-canvas-soft-2 transition-colors focus-visible:ring-2 focus-visible:ring-primary focus-visible:outline-none">Dashboard</a>
                    <a href="/contact" class="hidden sm:inline-block text-body text-xs md:text-sm font-medium hover:text-ink px-2 md:px-3 py-1.5 rounded-full hover:bg-canvas-soft-2 transition-colors focus-visible:ring-2 focus-visible:ring-primary focus-visible:outline-none">Contact Us</a>
                </nav>
            </div>
        </header>

        <!-- Main Content -->
		<main class="flex-grow flex flex-col items-center">
			<slot />
		</main>

        <!-- Footer -->
        <footer class="bg-canvas border-t border-hairline py-4xl mt-5xl">
            <div class="max-w-[1400px] mx-auto px-lg flex flex-col md:flex-row justify-between gap-xl">
                <div class="flex flex-col max-w-[384px]">
                    <div class="flex items-center gap-2 font-semibold text-ink mb-md">
                        <svg viewBox="0 0 24 24" width="24" height="24" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"><path d="M3 7V5a2 2 0 0 1 2-2h2"></path><path d="M17 3h2a2 2 0 0 1 2 2v2"></path><path d="M21 17v2a2 2 0 0 1-2 2h-2"></path><path d="M7 21H5a2 2 0 0 1-2-2v-2"></path><rect width="7" height="5" x="7" y="7" rx="1"></rect><rect width="7" height="5" x="10" y="12" rx="1"></rect></svg>
                        <span>TF Aadhaar Cropper</span>
                    </div>
                    <p class="text-sm text-body leading-relaxed">
                        The most secure and fast way to crop and print your Aadhaar Card. 100% browser-based processing ensures your data never leaves your device.
                    </p>
                </div>
                
                <div class="grid grid-cols-2 gap-xl">
                    <div class="flex flex-col gap-sm">
                        <h3 class="font-mono text-xs font-semibold text-ink uppercase tracking-wider mb-xs">Legal</h3>
                        <a href="/privacy-policy" class="text-sm text-body hover:text-link transition-colors focus-visible:ring-2 focus-visible:ring-primary focus-visible:outline-none rounded-xs">Privacy Policy</a>
                        <a href="/terms-and-conditions" class="text-sm text-body hover:text-link transition-colors focus-visible:ring-2 focus-visible:ring-primary focus-visible:outline-none rounded-xs">Terms & Conditions</a>
                        <a href="/disclaimer" class="text-sm text-body hover:text-link transition-colors focus-visible:ring-2 focus-visible:ring-primary focus-visible:outline-none rounded-xs">Disclaimer</a>
                    </div>
                    <div class="flex flex-col gap-sm">
                        <h3 class="font-mono text-xs font-semibold text-ink uppercase tracking-wider mb-xs">Company</h3>
                        <a href="/about-us" class="text-sm text-body hover:text-link transition-colors focus-visible:ring-2 focus-visible:ring-primary focus-visible:outline-none rounded-xs">About Us</a>
                        <a href="/contact" class="text-sm text-body hover:text-link transition-colors focus-visible:ring-2 focus-visible:ring-primary focus-visible:outline-none rounded-xs">Contact</a>
                        <a href="/dashboard" class="text-sm text-body hover:text-link transition-colors focus-visible:ring-2 focus-visible:ring-primary focus-visible:outline-none rounded-xs">Dashboard</a>
                    </div>
                </div>
            </div>
            <div class="max-w-[1400px] mx-auto px-lg mt-xl pt-lg border-t border-hairline flex flex-col md:flex-row justify-between items-center gap-sm">
                <p class="text-xs text-mute">© {new Date().getFullYear()} Techily Fly. All rights reserved.</p>
                <p class="text-xs text-mute">Developed by AbdurRahman</p>
            </div>
        </footer>
	</body>
</html>
